# Google Maps Platform. Places API (New) and Geocoding API must both be enabled
# on this project. Set a billing alert before the first live sweep: the
# Enterprise-tier free allowance covers only a few thousand businesses.
GOOGLE_MAPS_API_KEY=

# Supabase project. PostGIS must be enabled for coverage geometry.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sweep bounds (all optional; defaults shown) ---

# Largest radius a single request may ask for. Chosen so a dense suburb stays
# inside the wall-clock budget below, not because the API cannot go wider.
SWEEP_RADIUS_CEILING_METERS=5000

# Recursion floor for cell subdivision. A cell still saturated at this size is
# reported as possibly incomplete rather than split further.
SWEEP_MIN_CELL_SIZE_METERS=250

# Hard cap on Google requests per sweep. Without it, one deep sweep in a dense
# corridor is unbounded spend.
SWEEP_REQUEST_BUDGET=2000

# Hard cap on wall-clock time per sweep, calibrated against a 60s platform
# request timeout. Hitting it returns partial results flagged incomplete.
SWEEP_WALL_CLOCK_BUDGET_MS=45000

# --- Response shape ---

# Leads returned per call. The random draw below is only meaningful because the
# response is capped; uncapped, every qualified lead returns and there is no
# holdout at all.
RESPONSE_CAP=50

# Fraction of returned leads drawn at random regardless of score, so the
# scoring weights can be disconfirmed rather than only confirmed.
RESPONSE_HOLDOUT_FRACTION=0.15

# --- Freshness windows ---

# How long covered ground counts as swept, governing whether cells are
# re-queried through Google.
DISCOVERY_FRESHNESS_DAYS=90

# How long a lead's website evidence counts as current, governing whether the
# probe re-runs. Re-probing costs no Google request.
VERIFICATION_FRESHNESS_DAYS=14

# --- Website probe ---

PROBE_CONCURRENCY=25
PROBE_TIMEOUT_MS=5000

# Thresholds the domain applies when deciding whether a working site is poor.
QUALITY_MAX_RESPONSE_MS=3000
QUALITY_MIN_BODY_BYTES=2048

# --- Server ---

PORT=3000
