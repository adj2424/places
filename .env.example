PORT=3001
LOG_LEVEL=info
# Browser origin allowed to call this API (CORS). Defaults to http://localhost:3000 if unset.
CORS_ORIGIN=http://localhost:3000
# Same key is used for Places Nearby Search and Geocoding. Enable Geocoding API on this GCP project/key.
# GOOGLE_BASE_URL stays the Places host; Geocoding does not use it.
GOOGLE_API_KEY=
GOOGLE_PLACES_BASE_URL='https://places.googleapis.com/v1'
GOOGLE_GEOCODING_BASE_URL='https://maps.googleapis.com/maps/api/geocode/json'
